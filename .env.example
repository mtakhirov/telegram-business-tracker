# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Chat that receives notifications (your user ID, or a group/channel ID)
# Get your user ID from @userinfobot
ADMIN_CHAT_ID=your_chat_id_here

# Telegram user ID of the ONLY account allowed to connect this bot via
# Telegram Business. Anyone else is rejected and never recorded.
# Optional: defaults to ADMIN_CHAT_ID when that is your own user ID.
# Required when ADMIN_CHAT_ID is a group or channel.
OWNER_ID=your_user_id_here

# Display name used in the bot's own messages (default: Business Chat Archive)
BOT_NAME=Business Chat Archive

# Days to keep stored messages before automatic cleanup (default: 30)
RETENTION_DAYS=30
