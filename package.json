{
  "name": "telegram-business-tracker",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/app/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test --isolate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "start": "bun dist/app/index.js",
    "dev": "bun --watch src/app/index.ts",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/transformer-throttler": "^1.2.1",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.3",
    "envin": "^1.3.0",
    "grammy": "^1.40.1",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.3.1",
    "drizzle-kit": "^0.31.11",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2"
  }
}
